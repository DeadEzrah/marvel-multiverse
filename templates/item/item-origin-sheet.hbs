<div class="{{cssClass}}">
  <header class="sheet-header">
    <div class="mm-styled-field -lg -img">
      <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}" />
      <div class="mm-styled-input">
        <input name="name" type="text" value="{{item.name}}" placeholder="Name"/>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs mm-tabs -two" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="attributes">Attributes</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left rollable" for="system.description" data-label="description"><span>Description</span></label>
        <div class="mm-styled-input">
          <prose-mirror name="system.description" value="{{system.description}}" document-uuid="{{item.uuid}}" {{#unless editable}}disabled{{/unless}}>{{{enriched.description}}}</prose-mirror>
        </div>
      </div>
    </div>

    {{!-- Attributes Tab --}}
    <div class="tab attributes" data-group="primary" data-tab="attributes">
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left"><span>Examples</span></label>
        <div class="mm-styled-input">
          <input type="text" name="system.examples" value="{{system.examples}}" data-dtype="String" />
        </div>
      </div>
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left"><span>Suggested Occupation</span></label>
        <div class="mm-styled-input">
          <input type="text" name="system.suggestedOccupation" value="{{system.suggestedOccupation}}" data-dtype="String" />
        </div>
      </div>
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left"><span>Minimum Rank</span></label>
        <div class="mm-styled-input">
          <input type="number" name="system.minimumRank" value="{{system.minimumRank}}" data-dtype="Number" />
        </div>
      </div>
      <div class="mm-styled-field -fill">
        <label class="mm-styled-label -align-left"><span>Limitation</span></label>
        <div class="mm-styled-input">
          <input type="text" name="system.limitation" value="{{system.limitation}}" data-dtype="String" />
        </div>
      </div>
    </div>
  </section>

</div>
