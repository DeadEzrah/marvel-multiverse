<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>{{localize "Items"}}</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="{{localize 'DOCUMENT.Create' type="Item"}}"
        data-type="gear"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#if gear.length}}
    {{#each gear as |item id|}}
      <li class="flexrow item mm-item" data-item-id='{{item._id}}'>
        <div class="item-name mm-item-name" title="{{item.name}}">
          <span title="{{item.name}}">{{item.name}}</span>
        </div>
        <div class="item-controls">
          <a
            class="item-control item-edit"
            title="{{localize 'DOCUMENT.Update' type="Item"}}"
          >
            <i class="fas fa-edit"></i>
          </a>
          <a
            class="item-control item-delete"
            title="{{localize 'DOCUMENT.Delete' type="Item"}}"
          >
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
    {{/each}}
  {{else}}
    <li class="mm-empty-state">No gear recorded yet.</li>
  {{/if}}
</ol>
<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Campaign Frameworks</span>
    <hr />
    <div class="item-controls">
      <a class="item-control item-create" title="Create Campaign Framework" data-type="campaignFramework">
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#if campaignFrameworks.length}}
    {{#each campaignFrameworks as |item|}}
      <li class="flexrow item mm-item" data-item-id="{{item._id}}">
        <div class="item-name mm-item-name" title="{{item.name}}">
          <span>{{item.name}}</span>
          <small>{{item.system.frameworkType}}</small>
        </div>
        <div class="item-controls">
          <a class="item-control item-edit" title="Edit Campaign Framework"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete Campaign Framework"><i class="fas fa-trash"></i></a>
        </div>
      </li>
    {{/each}}
  {{else}}
    <li class="mm-empty-state">No campaign frameworks linked to this actor.</li>
  {{/if}}
</ol>
<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Alternate Forms</span>
    <hr />
    <div class="item-controls">
      <a class="item-control item-create" title="Create Alternate Form" data-type="alternateForm">
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#if alternateForms.length}}
    {{#each alternateForms as |item|}}
      <li class="flexrow item mm-item" data-item-id="{{item._id}}">
        <div class="item-name mm-item-name" title="{{item.name}}">
          <span>{{item.name}}</span>
        </div>
        <div class="item-controls">
          {{#if item.system.active}}
            <a class="item-control" data-action="deactivateAlternateForm" title="Deactivate Form"><i class="fas fa-toggle-on"></i></a>
          {{else}}
            <a class="item-control" data-action="activateAlternateForm" title="Activate Form"><i class="fas fa-toggle-off"></i></a>
          {{/if}}
          <a class="item-control item-edit" title="Edit Alternate Form"><i class="fas fa-edit"></i></a>
          <a class="item-control item-delete" title="Delete Alternate Form"><i class="fas fa-trash"></i></a>
        </div>
      </li>
    {{/each}}
  {{else}}
    <li class="mm-empty-state">No alternate forms recorded yet.</li>
  {{/if}}
</ol>
