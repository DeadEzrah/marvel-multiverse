<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Tags</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="Create item"
        data-type="tag"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
  {{#if tags.length}}
    {{#each tags as |item id|}}
      <li class="flexrow item mm-item" data-item-id='{{item._id}}'>
        <div class="item-name mm-item-name" title="{{item.name}}">
          <a class="rollable" data-roll-type="item" title="{{item.name}}"><span>{{item.name}}</span></a>
        </div>
        <div class="item-controls">
          <a
            class="item-control item-edit"
            title="{{localize 'DOCUMENT.Edit' type="tag"}}"
          >
            <i class="fas fa-edit"></i>
          </a>
          <a
            class="item-control item-delete"
            title="{{localize 'DOCUMENT.Delete' type="tag"}}"
          >
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
    {{/each}}
  {{else}}
    <li class="mm-empty-state">No tags recorded yet.</li>
  {{/if}}
</ol>
