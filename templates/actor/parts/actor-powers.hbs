{{!-- Always-visible add control: category groups below only render once they contain a power,
     so this is the only way to add a first power (e.g. on a freshly-created NPC/character). --}}
<ol class="mm-item-list">
  <li class="flexrow item mm-item-header">
    <span>Powers</span>
    <hr />
    <div class="item-controls">
      <a
        class="item-control item-create"
        title="{{localize 'DOCUMENT.Create' type="Power"}}"
        data-type="power"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </li>
</ol>
{{#each powers as |powers powerSet|}}
  {{#if powers.length}}
    <ol class="mm-item-list">
      <li class="flexrow item mm-item-header">
        <span>{{localize "MARVEL_MULTIVERSE.Item.Power.PowerSET" set=powerSet}}</span>
        <hr />
        <div class="item-controls">
          <a
            class="item-control item-create"
            title="{{localize 'DOCUMENT.Create' type="Power"}}"
            data-type="power"
            data-power-set="{{powerSet}}"
          >
            <i class="fas fa-plus"></i>
          </a>
        </div>
      </li>
      {{#each powers as |item id|}}
        <li class="flexrow item mm-item" data-item-id="{{item._id}}" >
          <div class="item-name mm-item-name" title="{{item.name}}">
            <a class="rollable"
              title="{{item.name}}"
              {{#if item.system.ability }}
                data-formula="{1d6,1dm,1d6}+@abilities.{{item.system.ability}}.value"
                data-label="{{item.system.ability}}"
                data-damagetype="{{item.system.damageType}}"
                data-item-id="{{item._id}}"
              {{else}}
                data-roll-type="item" data-item-id="{{item._id}}"
              {{/if}}
              <span>{{item.name}}</span>
              {{#if item.system.cost }}
                <span>Cost: {{item.system.cost}}</span>
              {{/if}}
            </a>
          </div>
          <div class="item-controls">
            <a
              class="item-control item-edit"
              title="{{localize 'DOCUMENT.Edit' type="power"}}"
            >
              <i class="fas fa-edit"></i>
            </a>
            <a
              class="item-control item-delete"
              title="{{localize 'DOCUMENT.Delete' type="power"}}"
            >
              <i class="fas fa-trash"></i>
            </a>
          </div>
        </li>
      {{/each}}
    </ol>
  {{/if}}
{{/each}}
