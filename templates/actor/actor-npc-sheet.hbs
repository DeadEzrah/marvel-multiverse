<div class="{{cssClass}} npc mmrdp-sheet flexcol">
  <header class="mmrdp-hero">
    <img class="mmrdp-portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" alt="">
    <div class="mmrdp-identity">
      <div class="mmrdp-kicker">Marvel Multiverse Role-Playing Game</div>
      <input class="mmrdp-name" name="name" type="text" value="{{actor.name}}" aria-label="NPC Name">
      <div class="mmrdp-subtitle">
        {{#if system.realname}}<span>{{system.realname}}</span>{{/if}}
        {{#if system.teams}}<span>{{system.teams}}</span>{{/if}}
        {{#if system.base}}<span>{{system.base}}</span>{{/if}}
      </div>
    </div>
    <label class="mmrdp-rankbox">
      <span class="mmrdp-rankbox__label">Rank</span>
      <input class="mmrdp-rankbox__value" name="system.attributes.rank.value" type="number" value="{{system.attributes.rank.value}}">
    </label>
  </header>

  <section class="mmrdp-stats">
    <div class="mmrdp-resource mmrdp-resource--health">
      <span class="mmrdp-resource__head">
        <span class="mmrdp-resource__name">Health</span>
        <span class="mmrdp-resource__numbers">
          <input name="system.health.value" type="number" value="{{modernResources.health.value}}" aria-label="Current Health">
          <span>/</span>
          <input name="system.health.max" type="number" value="{{modernResources.health.max}}" aria-label="Maximum Health">
        </span>
      </span>
      <span class="mmrdp-resource__controls" aria-label="Health controls">
        <button type="button" data-action="adjustResource" data-resource="health" data-adjust="full">Restore</button>
        <button type="button" data-action="adjustResource" data-resource="health" data-adjust="decrement" aria-label="Decrease Health">−</button>
        <button type="button" data-action="adjustResource" data-resource="health" data-adjust="set" aria-label="Set Health">#</button>
        <button type="button" data-action="adjustResource" data-resource="health" data-adjust="increment" aria-label="Increase Health">+</button>
      </span>
      <span class="mmrdp-resource__meta"><b>Damage Reduction</b><strong>{{system.healthDamageReduction}}</strong></span>
      <span class="mmrdp-resource__bar"><span style="--pct: {{modernResources.health.percent}}%"></span></span>
    </div>
    <div class="mmrdp-resource mmrdp-resource--focus">
      <span class="mmrdp-resource__head">
        <span class="mmrdp-resource__name">Focus</span>
        <span class="mmrdp-resource__numbers">
          <input name="system.focus.value" type="number" value="{{modernResources.focus.value}}" aria-label="Current Focus">
          <span>/</span>
          <input name="system.focus.max" type="number" value="{{modernResources.focus.max}}" aria-label="Maximum Focus">
        </span>
      </span>
      <span class="mmrdp-resource__controls" aria-label="Focus controls">
        <button type="button" data-action="adjustResource" data-resource="focus" data-adjust="full">Restore</button>
        <button type="button" data-action="adjustResource" data-resource="focus" data-adjust="decrement" aria-label="Decrease Focus">−</button>
        <button type="button" data-action="adjustResource" data-resource="focus" data-adjust="set" aria-label="Set Focus">#</button>
        <button type="button" data-action="adjustResource" data-resource="focus" data-adjust="increment" aria-label="Increase Focus">+</button>
      </span>
      <span class="mmrdp-resource__meta"><b>Damage Reduction</b><strong>{{system.focusDamageReduction}}</strong></span>
      <span class="mmrdp-resource__bar"><span style="--pct: {{modernResources.focus.percent}}%"></span></span>
    </div>
    <div class="mmrdp-resource mmrdp-resource--karma">
      <span class="mmrdp-resource__head">
        <span class="mmrdp-resource__name">Karma</span>
        <span class="mmrdp-resource__numbers">
          <input name="system.karma.value" type="number" value="{{modernResources.karma.value}}" aria-label="Current Karma">
          <span>/</span>
          <input name="system.karma.max" type="number" value="{{modernResources.karma.max}}" aria-label="Maximum Karma">
        </span>
      </span>
      <span class="mmrdp-resource__controls" aria-label="Karma controls">
        <button type="button" data-action="adjustResource" data-resource="karma" data-adjust="full">Restore</button>
        <button type="button" data-action="adjustResource" data-resource="karma" data-adjust="decrement" aria-label="Decrease Karma">−</button>
        <button type="button" data-action="adjustResource" data-resource="karma" data-adjust="set" aria-label="Set Karma">#</button>
        <button type="button" data-action="adjustResource" data-resource="karma" data-adjust="increment" aria-label="Increase Karma">+</button>
      </span>
      <span class="mmrdp-resource__bar"><span style="--pct: {{modernResources.karma.percent}}%"></span></span>
    </div>
    <div class="mmrdp-movement">
      <span class="mmrdp-movement__title">Speed</span>
      {{#each modernMovement as |movement|}}
        <span class="mmrdp-movement__stat"><strong>{{movement.value}}</strong>{{localize movement.label}}</span>
      {{/each}}
    </div>
    <button type="button" class="mmrdp-initiative rollable roll-initiative" data-action="rollInitiative"><span>Initiative Modifier</span><strong>{{numberFormat system.attributes.init.value decimals=0 sign=true}}</strong></button>
  </section>

  <main class="mmrdp-main mmrdp-main--compact">
    <nav class="sheet-tabs tabs mmrdp-tabs" data-group="primary">
      <a class="item mmrdp-tab active" data-tab="stats">Stats</a>
      <a class="item mmrdp-tab" data-tab="abilities">Powers</a>
      <a class="item mmrdp-tab" data-tab="traits">Traits &amp; Tags</a>
      <a class="item mmrdp-tab" data-tab="gear">Equipment</a>
      <a class="item mmrdp-tab" data-tab="biography">Biography</a>
      <a class="item mmrdp-tab" data-tab="conditions">Conditions</a>
    </nav>

    <section class="sheet-body mmrdp-content">
      <div class="tab mmrdp-page active" data-group="primary" data-tab="stats">
        <div class="mmrdp-layout-2 mmrdp-stats-layout">
          <section class="mmrdp-card">
            <h2 class="mmrdp-card__title"><span>Abilities</span></h2>
            <div class="mmrdp-card__body">
              {{#each modernAbilities as |ability|}}
                <div class="mmrdp-ability">
                  <button type="button" class="mmrdp-ability__roll rollable" data-formula="{1d6,1dm,1d6}+@abilities.{{ability.key}}.value" data-label="{{ability.key}}" title="Roll {{ability.label}}"><span class="mmrdp-ability__letter">{{ability.letter}}</span><span class="mmrdp-ability__name">{{ability.label}}</span></button>
                  <label class="mmrdp-ability__value"><input name="system.abilities.{{ability.key}}.value" type="number" value="{{ability.value}}" aria-label="{{ability.label}} score"><small>Ability</small></label>
                  <span class="mmrdp-ability__def"><strong>{{ability.defense}}</strong><small>Defense</small></span>
                  <button type="button" class="mmrdp-ability__noncom rollable" data-formula="{1d6,1dm,1d6}+@abilities.{{ability.key}}.noncom" data-label="{{ability.key}} non-combat"><strong>{{numberFormat ability.noncom decimals=0 sign=true}}</strong><small>Non-Combat</small></button>
                </div>
              {{/each}}
            </div>
          </section>
          <section class="mmrdp-card mmrdp-damage-card">
            <h2 class="mmrdp-card__title"><span>Damage</span></h2>
            <div class="mmrdp-card__body mmrdp-damage-grid">
              {{#each modernAbilities as |ability|}}
                {{#if (or (eq ability.key "mle") (eq ability.key "agl") (eq ability.key "ego") (eq ability.key "log"))}}
                  <div class="mmrdp-damage-chip" data-ability-key="{{ability.key}}">
                    <span>{{ability.label}}</span>
                    <strong>
                      <img class="mmrdp-damage-chip__die" src="systems/marvel-multiverse/ui/official/marvel-special-die-with-logo.png" alt="Marvel die">
                      <span class="mmrdp-damage-chip__operator">×</span>
                      <span class="mmrdp-damage-chip__term"><span class="mmrdp-damage-chip__multiplier">{{ability.damageMultiplier}}</span><small>Multiplier</small></span>
                      <span class="mmrdp-damage-chip__operator">+</span>
                      <span class="mmrdp-damage-chip__term"><output class="mmrdp-damage-chip__bonus">{{ability.value}}</output><small>Ability</small></span>
                    </strong>
                  </div>
                {{/if}}
              {{/each}}
            </div>
          </section>
        </div>
      </div>

      <div class="tab mmrdp-page" data-group="primary" data-tab="abilities">
        <div class="mmrdp-layout-2">
          <section class="mmrdp-card">
            <h2 class="mmrdp-card__title"><span>Powers</span></h2>
            <div class="mmrdp-card__body">{{> "systems/marvel-multiverse/templates/actor/parts/actor-powers.hbs"}}</div>
          </section>
          <section class="mmrdp-card">
            <h2 class="mmrdp-card__title"><span>NPC Setup</span></h2>
            <div class="mmrdp-card__body mmrdp-action-setup">
              <label><span>Default Element</span><select name="system.defaultElement">{{selectOptions elements selected=system.defaultElement labelAttr="label" blank=""}}</select></label>
              <label><span>Team Maneuver</span><select name="system.teamManeuver.maneuverType">{{selectOptions teamManeuverTypes selected=system.teamManeuver.maneuverType labelAttr="label" blank=""}}</select></label>
              <label><span>Level</span><select name="system.teamManeuver.level">{{selectOptions teamManeuverLevels selected=system.teamManeuver.level}}</select></label>
            </div>
          </section>
        </div>
      </div>

      <div class="tab mmrdp-page" data-group="primary" data-tab="traits">
        <div class="mmrdp-layout-2">
          <section class="mmrdp-card"><h2 class="mmrdp-card__title"><span>Traits</span></h2><div class="mmrdp-card__body">{{> "systems/marvel-multiverse/templates/actor/parts/actor-traits.hbs"}}</div></section>
          <section class="mmrdp-card"><h2 class="mmrdp-card__title"><span>Tags</span></h2><div class="mmrdp-card__body">{{> "systems/marvel-multiverse/templates/actor/parts/actor-tags.hbs"}}</div></section>
        </div>
      </div>

      <div class="tab mmrdp-page" data-group="primary" data-tab="gear">
        <div class="mmrdp-layout-2">
          <section class="mmrdp-card"><h2 class="mmrdp-card__title"><span>Weapons</span></h2><div class="mmrdp-card__body">{{> "systems/marvel-multiverse/templates/actor/parts/actor-weapons.hbs"}}</div></section>
          <section class="mmrdp-card"><h2 class="mmrdp-card__title"><span>Gear</span></h2><div class="mmrdp-card__body">{{> "systems/marvel-multiverse/templates/actor/parts/actor-items.hbs"}}</div></section>
        </div>
      </div>

      <div class="tab mmrdp-page" data-group="primary" data-tab="biography">
        <div class="mmrdp-layout-2">
          <section class="mmrdp-card">
            <h2 class="mmrdp-card__title"><span>Identity</span></h2>
            <div class="mmrdp-card__body mmrdp-identity-grid">
              <label><span>Real Name</span><input type="text" name="system.realname" value="{{system.realname}}"></label>
              <label><span>Gender</span><input type="text" name="system.gender" value="{{system.gender}}"></label>
              <label><span>Size</span><select name="system.size">{{selectOptions sizeSelection labelAttr="label" selected=system.size blank=""}}</select></label>
              <label><span>Height</span><input type="text" name="system.height" value="{{system.height}}"></label>
              <label><span>Weight</span><input type="text" name="system.weight" value="{{system.weight}}"></label>
              <label><span>Eyes</span><input type="text" name="system.eyes" value="{{system.eyes}}"></label>
              <label><span>Hair</span><input type="text" name="system.hair" value="{{system.hair}}"></label>
              <label><span>Teams</span><input type="text" name="system.teams" value="{{system.teams}}"></label>
              <label><span>Base</span><input type="text" name="system.base" value="{{system.base}}"></label>
            </div>
          </section>
          <section class="mmrdp-card"><h2 class="mmrdp-card__title"><span>Biography</span></h2><div class="mmrdp-card__body">{{> "systems/marvel-multiverse/templates/actor/parts/actor-biography.hbs"}}</div></section>
        </div>
      </div>

      <div class="tab mmrdp-page" data-group="primary" data-tab="conditions">
        <div class="mmrdp-card">
          <h2 class="mmrdp-card__title"><span>Concentration</span></h2>
          <div class="mmrdp-card__body mmrdp-status-summary"><span>{{#if statusDisplay.concentration.active}}Concentrating: {{statusDisplay.concentration.itemName}}{{else}}No active concentration.{{/if}}</span>{{#if editable}}<button type="button" class="mmrdp-mini-btn" data-action="{{#if statusDisplay.concentration.active}}endConcentration{{else}}startConcentration{{/if}}">{{#if statusDisplay.concentration.active}}End{{else}}Start{{/if}}</button>{{/if}}</div>
        </div>
        <div class="mmrdp-card">
          <h2 class="mmrdp-card__title"><span>Conditions &amp; Effects</span></h2>
          <div class="mmrdp-card__body">{{> "systems/marvel-multiverse/templates/actor/parts/actor-effects.hbs"}}</div>
        </div>
      </div>
    </section>
  </main>
</div>

