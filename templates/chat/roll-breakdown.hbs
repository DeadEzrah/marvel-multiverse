{{#if parts.length}}
    <div class="dice-tooltip">
        {{#each parts}}
            <section class="tooltip-part">
                <div class="dice">
                    <ol class="dice-rolls">
                        {{#each rolls}}
                            <li class="roll {{ classes }}">
                                <span data-action="chat-select-die" data-die-index="{{ @index }}">
                                    {{#if @root.isPrivate}}?{{else}}
                                        {{ result }}
                                    {{/if}}
                                </span>
                            </li>
                        {{/each}}
                    </ol>
                </div>
            </section>
        {{/each}}
    </div>
{{/if}}
